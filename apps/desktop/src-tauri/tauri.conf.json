{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brik",
  "version": "0.1.0",
  "identifier": "dk.brik.editor",
  "build": {
    "devUrl": "http://localhost:5180",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": { "script": "corepack pnpm editor", "cwd": "../.." },
    "beforeBuildCommand": { "script": "corepack pnpm build:editor", "cwd": "../.." }
  },
  "app": {
    "windows": [{ "label": "main", "title": "Brik", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
