{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "brik": [
        ".brik/types/brik/index.d.ts"
      ],
      "@brik/*": [
        ".brik/types/@brik/*/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    ".brik"
  ]
}
